{
    "name": "console-journal",
    "productName": "Console Journal",
    "version": "0.1.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*",
        "adapters/*"
    ],
    "description": "Retro console + CM6 writer",
    "main": "apps/desktop/electron/main.js",
    "scripts": {
        "start:desktop": "electron apps/desktop/electron/main.js",
        "start:web": "node apps/web/server.js",
        "start:web:https": "DEV_HTTPS=1 node apps/web/server.js",
        "bundle": "esbuild packages/ui/js/main.js --bundle --format=esm --outfile=packages/ui/dist/renderer.js --sourcemap",
        "bundle:watch": "esbuild packages/ui/js/main.js --bundle --format=esm --outfile=packages/ui/dist/renderer.js --sourcemap --watch",
        "dev": "npm-run-all --parallel bundle:watch start:web",
        "build:web": "npm run bundle",
        "build:desktop": "electron-builder"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6",
        "@codemirror/commands": "^6",
        "@codemirror/lang-markdown": "^6",
        "@codemirror/language": "^6",
        "@codemirror/lint": "^6",
        "@codemirror/search": "^6",
        "@codemirror/state": "^6",
        "@codemirror/view": "^6",
        "@lezer/highlight": "^1",
        "@marijn/find-cluster-break": "^1.0.2",
        "better-sqlite3": "^11.10.0",
        "express": "^4.19.2",
        "idb": "^8.0.0",
        "marked": "^12.0.2"
    },
    "devDependencies": {
        "@electron/rebuild": "^3.7.2",
        "electron": "^31.0.0",
        "electron-builder": "^26.0.12",
        "esbuild": "^0.25.11",
        "npm-run-all": "^4.1.5"
    },
    "build": {
        "appId": "com.console.journal",
        "productName": "Console Journal",
        "copyright": "©2025 John Kakuk. All rights reserved.",
        "directories": {
            "buildResources": "assets",
            "output": "dist"
        },
        "files": [
            "apps/desktop/electron/**/*",
            "apps/desktop/icon/**/*",
            "packages/ui/index.html",
            "packages/ui/css/**/*",
            "packages/ui/dist/**/*",
            "packages/ui/pdf.css",
            "packages/ui/style.css",
            {
                "from": "node_modules",
                "to": "node_modules",
                "filter": [
                    "@codemirror/**/*",
                    "@marijn/**/*",
                    "style-mod/**/*",
                    "marked/**/*"
                ]
            },
            "!**/*.map",
            "!**/*.md",
            "!**/__tests__/**",
            "!**/test/**",
            "!**/tests/**",
            "!**/examples/**",
            "!**/example/**",
            "!**/docs/**"
        ],
        "asar": true,
        "asarUnpack": [
            "**/*.node"
        ],
        "mac": {
            "category": "public.app-category.productivity",
            "target": "dmg",
            "icon": "apps/desktop/icon/icon.icns"
        },
        "win": {
            "target": "nsis"
        },
        "linux": {
            "target": [
                "AppImage"
            ],
            "category": "Utility"
        }
    }
}
